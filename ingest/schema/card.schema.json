{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "card.schema.json",
  "title": "One row of sets/<lang>/<set>.tsv, a full card record",
  "columns": ["id", "n", "name", "version", "cost", "ink", "type", "img", "set3", "num3", "lorcast", "landscape", "strength", "willpower", "lore", "text", "rarity", "moveCost", "maxCopiesInDeck", "formats", "keywords", "fullName", "inkwell", "set", "setCode", "number", "variant", "thumb", "subtypes", "baseId"],
  "type": "object",
  "required": ["id", "n", "name", "cost", "ink", "type", "img", "set3", "landscape", "rarity", "formats", "keywords", "fullName", "inkwell", "set", "setCode", "subtypes"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "integer", "minimum": 1},
    "n": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "cost": {"type": "integer", "minimum": 0},
    "ink": {"type": "array", "maxItems": 2, "items": {"enum": ["Amber", "Amethyst", "Emerald", "Ruby", "Sapphire", "Steel"]}},
    "type": {"enum": ["Character", "Action", "Item", "Location"]},
    "img": {"$ref": "#/$defs/imageUrl"},
    "set3": {"type": "string", "pattern": "^([0-9]{3}|[A-Za-z][A-Za-z0-9]{0,11})$"},
    "num3": {"type": "string", "pattern": "^[0-9]{3,}$"},
    "lorcast": {"type": "string", "pattern": "^crd_[0-9a-f]{32}$"},
    "landscape": {"type": "boolean"},
    "strength": {"type": "integer", "minimum": 0},
    "willpower": {"type": "integer", "minimum": 0},
    "lore": {"type": "integer", "minimum": 0},
    "text": {"type": "string"},
    "rarity": {"enum": ["Common", "Uncommon", "Rare", "Super Rare", "Legendary", "Epic", "Enchanted", "Iconic", "Special"]},
    "moveCost": {"type": "integer", "minimum": 0},
    "maxCopiesInDeck": {"type": "integer", "minimum": 1},
    "formats": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9]+:[01]:([0-9]{4}-[0-9]{2}-[0-9]{2})?:([0-9]{4}-[0-9]{2}-[0-9]{2})?$"}},
    "keywords": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "fullName": {"type": "string", "minLength": 1},
    "inkwell": {"type": "boolean"},
    "set": {"type": "string", "pattern": "^[A-Za-z0-9]{1,12}$"},
    "setCode": {"type": "string", "pattern": "^[A-Za-z0-9]{1,12}$"},
    "number": {"type": "integer", "minimum": 0},
    "variant": {"type": "string", "pattern": "^[a-z]$"},
    "thumb": {"$ref": "#/$defs/imageUrl"},
    "subtypes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "baseId": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "imageUrl": {"type": "string", "pattern": "^https://api\\.lorcana\\.ravensburger\\.com/[A-Za-z0-9/_.-]+\\.(jpg|png)$"}
  }
}
